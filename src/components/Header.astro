---
import { SITE, NAV, SOCIAL } from '../config';
import ThemeToggle from './ThemeToggle.astro';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---
<header
  class="sticky top-0 z-40 border-b border-[var(--color-border)] bg-[color-mix(in_oklab,var(--color-bg)_88%,transparent)] backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-4xl items-center gap-4 px-5">
    <a href="/" class="group flex items-center gap-2 font-semibold tracking-tight">
      <span class="grid size-8 place-items-center rounded-lg bg-[var(--color-accent)] font-mono text-sm font-bold text-[var(--color-accent-fg)]">w</span>
      <span class="hidden sm:inline">{SITE.title}</span>
    </a>

    <nav class="ml-auto flex items-center gap-1 text-sm">
      {NAV.map((item) => (
        <a
          href={item.href}
          class:list={[
            'rounded-lg px-3 py-1.5 transition-colors',
            isActive(item.href)
              ? 'font-medium text-[var(--color-fg)] bg-[color-mix(in_oklab,var(--color-accent)_12%,transparent)]'
              : 'text-[var(--color-muted)] hover:text-[var(--color-fg)]',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-1.5">
      <a
        href={SOCIAL.github}
        target="_blank"
        rel="noopener"
        class="grid size-9 place-items-center rounded-lg border border-[var(--color-border)] text-[var(--color-muted)] transition-colors hover:text-[var(--color-fg)] hover:border-[var(--color-accent)]"
        aria-label="GitHub"
        title="GitHub"
      >
        <svg class="size-5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>
