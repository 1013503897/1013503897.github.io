---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { getPosts, formatDate, isoDate, tagSlug } from '../../lib/utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const { title, summary, created, updated, tags, venue, target } = post.data;
const minutesRead = remarkPluginFrontmatter?.minutesRead as string | undefined;
const hasMermaid = post.body?.includes('```mermaid') ?? false;
---
<Base title={title} description={summary} article={true}>
  <div class="mx-auto max-w-4xl px-5 pt-10">
    <a href="/" class="mb-6 inline-flex items-center gap-1.5 font-mono text-sm text-[var(--color-muted)] transition-colors hover:text-[var(--color-accent)]">
      <span aria-hidden="true">←</span> 返回首页
    </a>

    <header class="border-b border-[var(--color-border)] pb-6">
      <div class="mb-3 flex flex-wrap items-center gap-3 text-xs text-[var(--color-muted)]">
        <time datetime={isoDate(created)}>{formatDate(created)}</time>
        {updated && <span>· 更新于 {formatDate(updated)}</span>}
        {minutesRead && <span>· {minutesRead}</span>}
        {venue && <span class="rounded-full border border-[var(--color-border)] px-2 py-0.5 font-mono">{venue}</span>}
      </div>
      <h1 class="text-2xl font-bold leading-tight tracking-tight sm:text-3xl">{title}</h1>
      {summary && <p class="mt-3 text-[var(--color-muted)] leading-relaxed">{summary}</p>}
      {target && (
        <p class="mt-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-2 font-mono text-xs text-[var(--color-muted)]">
          <span class="text-[var(--color-accent)]">target</span> · {target}
        </p>
      )}
      {tags && tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-1.5">
          {tags.map((t) => (
            <li>
              <a href={`/tags/${tagSlug(t)}`} class="rounded-md bg-[color-mix(in_oklab,var(--color-accent)_9%,transparent)] px-2 py-0.5 font-mono text-xs text-[var(--color-muted)] transition-colors hover:text-[var(--color-accent)]">#{t}</a>
            </li>
          ))}
        </ul>
      )}
    </header>
  </div>

  <div class="mx-auto max-w-4xl gap-10 px-5 lg:grid lg:max-w-6xl lg:grid-cols-[1fr_15rem]">
    <article class="prose prose-lg py-8" data-pagefind-body>
      <Content />
    </article>

    <aside class="hidden lg:block">
      <div class="sticky top-24 py-8">
        <TableOfContents headings={headings} />
      </div>
    </aside>
  </div>
</Base>

{hasMermaid && (
  <script>
    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@12/dist/mermaid.esm.min.mjs';
    // keep the original source so re-theming on toggle can re-parse
    const sources = [...document.querySelectorAll('pre.mermaid')].map((el) => el.textContent);
    const vars = (dark) =>
      dark
        ? {
            darkMode: true, background: '#17171a',
            mainBkg: '#1f1f23', primaryColor: '#1f1f23', nodeBorder: '#3a3a3f',
            primaryTextColor: '#e9e9e6', nodeTextColor: '#e9e9e6', titleColor: '#e9e9e6',
            primaryBorderColor: '#3a3a3f', lineColor: '#8a8a92',
            secondaryColor: '#26262b', tertiaryColor: '#1a1a1e',
            clusterBkg: '#17171a', clusterBorder: '#3a3a3f',
            edgeLabelBackground: '#17171a', textColor: '#e9e9e6',
            fontFamily: 'JetBrains Mono, ui-monospace, monospace',
          }
        : {
            darkMode: false, background: '#ffffff',
            mainBkg: '#f5f3f1', primaryColor: '#f5f3f1', nodeBorder: '#d3cdc8',
            primaryTextColor: '#1a1a19', nodeTextColor: '#1a1a19', titleColor: '#1a1a19',
            primaryBorderColor: '#d3cdc8', lineColor: '#8a8a82',
            secondaryColor: '#efe9e6', tertiaryColor: '#faf7f5',
            clusterBkg: '#faf7f5', clusterBorder: '#e7e7e4',
            edgeLabelBackground: '#ffffff', textColor: '#1a1a19',
            fontFamily: 'JetBrains Mono, ui-monospace, monospace',
          };
    let running = false;
    async function draw() {
      if (running) return;
      running = true;
      const nodes = [...document.querySelectorAll('pre.mermaid')];
      const dark = document.documentElement.dataset.theme === 'dark';
      mermaid.initialize({ startOnLoad: false, theme: 'base', themeVariables: vars(dark), securityLevel: 'strict' });
      nodes.forEach((el, i) => {
        el.removeAttribute('data-processed');
        el.innerHTML = '';
        el.textContent = sources[i];
      });
      try { await mermaid.run({ nodes }); } finally { running = false; }
    }
    draw();
    window.addEventListener('themechange', draw);
  </script>
)}
