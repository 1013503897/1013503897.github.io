---
import Base from '../layouts/Base.astro';
---
<Base title="404">
  <section class="mx-auto grid max-w-4xl place-items-center px-5 py-32 text-center">
    <p class="font-mono text-6xl font-bold text-[var(--color-accent)]">404</p>
    <p class="mt-4 text-[var(--color-muted)]">segfault：这个地址没有映射。</p>
    <a href="/" class="mt-8 rounded-lg border border-[var(--color-border)] px-4 py-2 text-sm transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]">返回首页</a>
  </section>
</Base>
